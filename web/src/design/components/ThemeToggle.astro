---
import Sun from './icons/Sun.astro';
import Moon from './icons/Moon.astro';
---

<theme-toggle>
  <button
    type="button"
    aria-label="Ativar tema escuro"
    aria-pressed="false"
    class="inline-flex size-10 cursor-pointer items-center justify-center rounded-md border border-line-strong text-ink-soft hover:bg-accent-soft hover:text-ink focus-visible:focus-ring"
  >
    <Sun class="hidden size-4 dark:block" />
    <Moon class="size-4 dark:hidden" />
  </button>
</theme-toggle>

<script>
  import '../elements/theme-toggle';
</script>

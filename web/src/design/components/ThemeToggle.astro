---
import Sun from './icons/Sun.astro';
import Moon from './icons/Moon.astro';
---

<button
  type="button"
  aria-label="Ativar tema escuro"
  aria-pressed="false"
  data-theme-toggle
  class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md border border-line-strong text-ink-soft hover:bg-accent-soft hover:text-ink focus-visible:focus-ring"
>
  <Sun class="hidden size-4 dark:block" />
  <Moon class="size-4 dark:hidden" />
</button>

<script>
  function syncToggles() {
    const dark = document.documentElement.classList.contains('dark');
    document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
      toggle.setAttribute('aria-pressed', String(dark));
      toggle.setAttribute('aria-label', dark ? 'Ativar tema claro' : 'Ativar tema escuro');
    });
  }

  syncToggles();

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]'))
      return;
    const root = document.documentElement;
    root.classList.add('theme-switching');
    const dark = root.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
    syncToggles();
    void root.offsetHeight;
    requestAnimationFrame(() => root.classList.remove('theme-switching'));
  });
</script>

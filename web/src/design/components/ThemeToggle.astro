---
import Sun from './icons/Sun.astro';
import Moon from './icons/Moon.astro';
---

<button
  type="button"
  aria-label="Alternar tema"
  data-theme-toggle
  class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md border border-line-strong text-ink-soft hover:bg-accent-soft hover:text-ink"
>
  <Sun class="hidden size-4 dark:block" />
  <Moon class="size-4 dark:hidden" />
</button>

<script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]'))
      return;
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>

---
interface Props {
  variant?: 'soft' | 'outline';
  class?: string;
}

const { variant = 'soft', class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium',
    variant === 'soft' ? 'bg-accent-soft text-accent' : 'border border-line text-ink-soft',
    className,
  ]}
>
  <slot />
</span>

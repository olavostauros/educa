---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<section class:list={['mb-10', className]}>
  <h1 class="font-serif text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
  <p class="mt-3 max-w-2xl text-ink-soft"><slot /></p>
</section>

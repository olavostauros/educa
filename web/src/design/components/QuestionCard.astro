---
import Alternativa from './Alternativa.astro';
import Button from './Button.astro';
import Card from './Card.astro';
import Link from './Link.astro';
import QuestionMeta from './QuestionMeta.astro';

interface Question {
  id: string;
  banca: string;
  orgao: string;
  cargo: string;
  ano: number;
  assunto: string;
  tipo: 'certo_errado' | 'multipla_escolha';
  enunciado: string;
  alternativas: string[];
  gabarito: string;
  fonte: string;
}

interface Props {
  q: Question;
}

const { q } = Astro.props;

const letras = ['a', 'b', 'c', 'd', 'e'];
const certoErrado = q.tipo === 'certo_errado';
const opcoes = q.alternativas.map((alt, i) => ({
  valor: certoErrado ? alt.toLowerCase() : letras[i],
  letra: certoErrado ? undefined : letras[i].toUpperCase(),
  texto: alt,
}));
const gabaritoTexto = certoErrado
  ? q.gabarito === 'certo'
    ? 'Certo'
    : 'Errado'
  : `Alternativa ${q.gabarito.toUpperCase()}`;
---

<Card
  as="article"
  class="questao"
  data-banca={q.banca}
  data-orgao={q.orgao}
  data-cargo={q.cargo}
  data-ano={String(q.ano)}
  data-assunto={q.assunto}
  data-gabarito={q.gabarito}
  data-gabarito-texto={gabaritoTexto}
>
  <QuestionMeta banca={q.banca} orgao={q.orgao} cargo={q.cargo} ano={q.ano} assunto={q.assunto} />

  <p id={`enunciado-${q.id}`} class="mt-3 font-serif text-base leading-relaxed sm:text-lg">
    {q.enunciado}
  </p>

  <div
    class:list={['mt-3 grid gap-1.5', certoErrado && 'grid-cols-2']}
    role="radiogroup"
    aria-labelledby={`enunciado-${q.id}`}
  >
    {
      opcoes.map((op) => (
        <Alternativa valor={op.valor} letra={op.letra} class={certoErrado && 'justify-center'}>
          {op.texto}
        </Alternativa>
      ))
    }
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-4 text-sm">
    <Button variant="ghost" size="sm" type="button" data-ver-gabarito>Ver gabarito</Button>
    <p data-resultado role="status" class="hidden font-medium"></p>
    <Link href={q.fonte} variant="underline" class="ml-auto">
      Fonte oficial
    </Link>
  </div>
</Card>

<script>
  document.querySelectorAll<HTMLElement>('article.questao').forEach((card) => {
    const gabarito = card.dataset.gabarito;
    const gabaritoTexto = card.dataset.gabaritoTexto;
    const opcoes = [...card.querySelectorAll<HTMLButtonElement>('[data-opcao]')];
    const botao = card.querySelector<HTMLButtonElement>('[data-ver-gabarito]');
    const resultado = card.querySelector<HTMLElement>('[data-resultado]');
    if (!gabarito || !botao || !resultado || !opcoes.length) return;

    let respondida = false;

    function marcar(opcao: HTMLButtonElement) {
      opcoes.forEach((o) => {
        delete o.dataset.state;
        o.setAttribute('aria-checked', 'false');
        o.tabIndex = -1;
      });
      opcao.dataset.state = 'selected';
      opcao.setAttribute('aria-checked', 'true');
      opcao.tabIndex = 0;
    }

    opcoes.forEach((opcao, i) => {
      opcao.tabIndex = i === 0 ? 0 : -1;
      opcao.addEventListener('click', () => {
        if (!respondida) marcar(opcao);
      });
      opcao.addEventListener('keydown', (e) => {
        const delta = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
        if (!delta) return;
        e.preventDefault();
        const proximo = opcoes[(i + delta + opcoes.length) % opcoes.length];
        proximo.focus();
        if (!respondida) marcar(proximo);
      });
    });

    botao.addEventListener('click', () => {
      respondida = true;
      let acertou: boolean | null = null;
      opcoes.forEach((opcao) => {
        const correta = opcao.dataset.opcao === gabarito;
        const escolhida = opcao.getAttribute('aria-checked') === 'true';
        opcao.dataset.state = correta ? 'correct' : escolhida ? 'wrong' : 'dim';
        opcao.setAttribute('aria-disabled', 'true');
        if (escolhida) acertou = correta;
      });

      resultado.textContent =
        acertou === null
          ? `Gabarito: ${gabaritoTexto}`
          : `${acertou ? 'Você acertou' : 'Você errou'} — gabarito: ${gabaritoTexto}`;
      resultado.classList.remove('hidden');
      resultado.classList.add(
        acertou === false ? 'text-danger' : acertou ? 'text-success' : 'text-accent',
      );
      botao.classList.add('hidden');
      resultado.tabIndex = -1;
      resultado.focus();
    });
  });
</script>

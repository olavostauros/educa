---
interface Props {
  variant?: 'primary' | 'outline' | 'ghost';
  size?: 'sm' | 'md';
  href?: string;
  class?: string;
}

const { variant = 'primary', size = 'md', href, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  {...rest}
  href={href}
  class:list={[
    'inline-flex cursor-pointer items-center justify-center rounded-md font-medium transition-colors',
    size === 'sm' ? 'px-2.5 py-1 text-xs' : 'px-4 py-2 text-sm',
    variant === 'primary' && 'bg-accent text-paper hover:bg-accent-strong',
    variant === 'outline' && 'border border-line-strong bg-surface text-ink hover:bg-accent-soft',
    variant === 'ghost' && 'text-accent hover:bg-accent-soft',
    className,
  ]}
>
  <slot />
</Tag>

---
import Badge from './Badge.astro';
import Container from './Container.astro';
import Sun from './icons/Sun.astro';
import Moon from './icons/Moon.astro';
import { navItems } from '../nav';

const normalize = (href: string) => href.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);
---

<header class="sticky top-0 z-10 border-b border-line bg-paper/80 backdrop-blur">
  <Container class="flex flex-wrap items-center justify-between gap-x-6 py-3 sm:py-4">
    <a
      href={import.meta.env.BASE_URL}
      class="font-serif text-xl font-bold tracking-tight text-accent"
    >
      papiro
    </a>

    <nav aria-label="Principal" class="order-3 mt-2 w-full sm:order-none sm:mt-0 sm:w-auto">
      <ul class="flex gap-5 text-sm">
        {
          navItems.map((item) => {
            const active = normalize(item.href) === current;
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'underline-offset-8 transition-colors hover:text-ink',
                    active
                      ? 'font-medium text-ink underline decoration-accent decoration-2'
                      : 'text-ink-soft',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <Badge class="hidden sm:inline-flex">HackBrasil</Badge>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Alternar tema"
        class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md border border-line text-ink-soft hover:bg-accent-soft hover:text-ink"
      >
        <Sun class="hidden size-4 dark:block" />
        <Moon class="size-4 dark:hidden" />
      </button>
    </div>
  </Container>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>

---
interface Props {
  href: string;
  variant?: 'subtle' | 'underline';
  class?: string;
}

const { href, variant = 'subtle', class: className, ...rest } = Astro.props;
---

<a
  href={href}
  {...rest}
  class:list={[
    'text-ink-soft transition-colors hover:text-ink',
    variant === 'underline' && 'underline decoration-line underline-offset-2',
    className,
  ]}
>
  <slot />
</a>

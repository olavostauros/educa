---
interface Props {
  href?: string;
  size?: 'lg' | 'xl';
  class?: string;
}

const { href, size = 'xl', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'p';
---

<Tag
  href={href}
  {...rest}
  class:list={[
    'rounded-sm font-serif font-bold tracking-tight text-accent focus-visible:focus-ring',
    size === 'xl' ? 'text-xl' : 'text-lg',
    className,
  ]}
>
  papiro
</Tag>

---
import { navItems } from '../nav';

const projetoLinks = [
  { href: 'https://github.com/olavostauros/papiro', label: 'Código no GitHub' },
  { href: 'https://hackbrasil.com/', label: 'HackBrasil' },
  { href: 'https://github.com/olavostauros/plantao', label: 'Plantão' },
];
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto grid max-w-5xl gap-8 px-4 py-10 sm:grid-cols-3">
    <div>
      <p class="font-serif text-lg font-bold tracking-tight text-accent">papiro</p>
      <p class="mt-2 max-w-xs text-sm text-ink-soft">
        Provas e questões oficiais de concursos públicos brasileiros — de graça e sem cadastro.
      </p>
    </div>

    <nav aria-label="Rodapé">
      <p class="text-xs font-medium tracking-wide text-ink-soft uppercase">Navegação</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="text-ink-soft transition-colors hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Projeto">
      <p class="text-xs font-medium tracking-wide text-ink-soft uppercase">Projeto</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          projetoLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-ink-soft transition-colors hover:text-ink"
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-line">
    <p class="mx-auto max-w-5xl px-4 py-4 text-xs text-ink-soft">
      papiro — feito para o HackBrasil, trilha Acesso à educação.
    </p>
  </div>
</footer>

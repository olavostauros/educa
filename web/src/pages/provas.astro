---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../design/components/SiteHeader.astro';
import SiteFooter from '../design/components/SiteFooter.astro';
import Card from '../design/components/Card.astro';
---

<Layout title="papiro — provas">
  <SiteHeader />

  <main class="mx-auto max-w-5xl px-4 py-10">
    <section class="mb-10">
      <h1 class="font-serif text-3xl font-bold tracking-tight sm:text-4xl">Provas</h1>
      <p class="mt-3 max-w-2xl text-ink-soft">
        Provas oficiais completas por banca, órgão, cargo e ano.
      </p>
    </section>

    <Card>
      <p class="text-ink-soft">Em breve — a listagem de provas por concurso está em desenho.</p>
    </Card>
  </main>

  <SiteFooter />
</Layout>

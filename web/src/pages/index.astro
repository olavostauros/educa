---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../design/components/SiteHeader.astro';
import SiteFooter from '../design/components/SiteFooter.astro';
import Card from '../design/components/Card.astro';
import Container from '../design/components/Container.astro';
import Select from '../design/components/Select.astro';
import QuestionCard from '../design/components/QuestionCard.astro';
import questions from '../data/questions.json';

const filtros = [
  { id: 'banca', label: 'Banca', valores: [...new Set(questions.map((q) => q.banca))].sort() },
  { id: 'orgao', label: 'Órgão', valores: [...new Set(questions.map((q) => q.orgao))].sort() },
  { id: 'cargo', label: 'Cargo', valores: [...new Set(questions.map((q) => q.cargo))].sort() },
  {
    id: 'ano',
    label: 'Ano',
    valores: [...new Set(questions.map((q) => String(q.ano)))].sort().reverse(),
  },
  { id: 'assunto', label: 'Assunto', valores: [...new Set(questions.map((q) => q.assunto))].sort() },
];
---

<Layout title="papiro — questões de concursos públicos">
  <SiteHeader />

  <Container as="main" class="py-10">
    <section class="mb-10">
      <h1 class="font-serif text-3xl font-bold tracking-tight sm:text-4xl">
        Provas e questões oficiais de concursos, de graça
      </h1>
      <p class="mt-3 max-w-2xl text-ink-soft">
        Filtre por banca, órgão, cargo, ano e assunto. Resolva e confira o gabarito definitivo na
        hora, com a fonte de cada questão. Sem cadastro.
      </p>
    </section>

    <Card
      as="section"
      aria-label="Filtros"
      class="mb-8 grid grid-cols-2 gap-3 p-4 sm:grid-cols-3 lg:grid-cols-5"
    >
      {
        filtros.map((f) => (
          <Select label={f.label} options={f.valores} data-filtro={f.id} />
        ))
      }
      <p class="col-span-full text-sm text-ink-soft">
        <span id="contagem">{questions.length}</span> questões
      </p>
    </Card>

    <section class="space-y-4" aria-label="Questões">
      {questions.map((q) => <QuestionCard q={q} />)}
    </section>
  </Container>

  <SiteFooter />

  <script>
    const selects = document.querySelectorAll<HTMLSelectElement>('select[data-filtro]');
    const cards = document.querySelectorAll<HTMLElement>('article.questao');
    const contagem = document.getElementById('contagem');

    function filtrar() {
      const ativos = [...selects]
        .map((s) => ({ campo: s.dataset.filtro!, valor: s.value }))
        .filter((f) => f.valor !== '');

      let visiveis = 0;
      cards.forEach((card) => {
        const ok = ativos.every((f) => card.dataset[f.campo] === f.valor);
        card.classList.toggle('hidden', !ok);
        if (ok) visiveis++;
      });
      if (contagem) contagem.textContent = String(visiveis);
    }

    selects.forEach((s) => s.addEventListener('change', filtrar));
  </script>
</Layout>

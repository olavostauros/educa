---
import Layout from '../layouts/Layout.astro';
import questions from '../data/questions.json';

const letras = ['a', 'b', 'c', 'd', 'e'];
const gabaritoTexto = (q: (typeof questions)[number]) =>
  q.tipo === 'certo_errado'
    ? q.gabarito === 'certo'
      ? 'Certo'
      : 'Errado'
    : `Alternativa ${q.gabarito.toUpperCase()}`;

const filtros = [
  { id: 'banca', label: 'Banca', valores: [...new Set(questions.map((q) => q.banca))].sort() },
  { id: 'orgao', label: 'Órgão', valores: [...new Set(questions.map((q) => q.orgao))].sort() },
  { id: 'cargo', label: 'Cargo', valores: [...new Set(questions.map((q) => q.cargo))].sort() },
  {
    id: 'ano',
    label: 'Ano',
    valores: [...new Set(questions.map((q) => String(q.ano)))].sort().reverse(),
  },
  { id: 'assunto', label: 'Assunto', valores: [...new Set(questions.map((q) => q.assunto))].sort() },
];
---

<Layout title="Educa — Questões de concursos públicos">
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
      <a href={import.meta.env.BASE_URL} class="text-xl font-bold tracking-tight text-emerald-700">
        Educa
      </a>
      <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700">
        HackBrasil
      </span>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-4 py-10">
    <section class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Provas e questões oficiais de concursos, de graça
      </h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        Filtre por banca, órgão, cargo, ano e assunto. Resolva e confira o gabarito definitivo na
        hora, com a fonte de cada questão. Sem cadastro.
      </p>
    </section>

    <section
      class="mb-8 grid grid-cols-2 gap-3 rounded-xl border border-slate-200 bg-white p-4 sm:grid-cols-3 lg:grid-cols-5"
      aria-label="Filtros"
    >
      {
        filtros.map((f) => (
          <label class="flex flex-col gap-1 text-xs font-medium text-slate-500">
            {f.label}
            <select
              data-filtro={f.id}
              class="rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none"
            >
              <option value="">Todas</option>
              {f.valores.map((v) => (
                <option value={v}>{v}</option>
              ))}
            </select>
          </label>
        ))
      }
      <p class="col-span-full text-sm text-slate-500">
        <span id="contagem">{questions.length}</span> questões
      </p>
    </section>

    <section class="space-y-4" aria-label="Questões">
      {
        questions.map((q) => (
          <article
            class="questao rounded-xl border border-slate-200 bg-white p-5"
            data-banca={q.banca}
            data-orgao={q.orgao}
            data-cargo={q.cargo}
            data-ano={String(q.ano)}
            data-assunto={q.assunto}
          >
            <p class="flex flex-wrap gap-x-2 gap-y-1 text-xs text-slate-500">
              <span class="font-medium text-slate-700">{q.banca}</span>
              <span aria-hidden="true">·</span>
              <span>{q.orgao}</span>
              <span aria-hidden="true">·</span>
              <span>{q.cargo}</span>
              <span aria-hidden="true">·</span>
              <span>{q.ano}</span>
              <span class="ml-auto rounded-full bg-emerald-50 px-2 py-0.5 font-medium text-emerald-700">
                {q.assunto}
              </span>
            </p>

            <p class="mt-3 text-sm leading-relaxed sm:text-base">{q.enunciado}</p>

            <ul class="mt-3 space-y-1.5">
              {q.alternativas.map((alt, i) => (
                <li class="flex gap-2 text-sm text-slate-700">
                  <span class="font-medium text-slate-400">
                    {q.tipo === 'certo_errado' ? '' : `${letras[i].toUpperCase()})`}
                  </span>
                  {alt}
                </li>
              ))}
            </ul>

            <div class="mt-4 flex flex-wrap items-center gap-4 text-sm">
              <details class="group">
                <summary class="cursor-pointer font-medium text-emerald-700 select-none">
                  Ver gabarito
                </summary>
                <p class="mt-1.5 inline-block rounded-md bg-emerald-50 px-2 py-1 font-medium text-emerald-800">
                  {gabaritoTexto(q)}
                </p>
              </details>
              <a
                href={q.fonte}
                class="text-slate-500 underline decoration-slate-300 underline-offset-2 hover:text-slate-700"
              >
                Fonte oficial
              </a>
            </div>
          </article>
        ))
      }
    </section>
  </main>

  <footer class="border-t border-slate-200 py-6 text-center text-sm text-slate-500">
    Educa — provas e questões oficiais de concursos públicos brasileiros, de graça e sem cadastro.
  </footer>

  <script>
    const selects = document.querySelectorAll<HTMLSelectElement>('select[data-filtro]');
    const cards = document.querySelectorAll<HTMLElement>('article.questao');
    const contagem = document.getElementById('contagem');

    function filtrar() {
      const ativos = [...selects]
        .map((s) => ({ campo: s.dataset.filtro!, valor: s.value }))
        .filter((f) => f.valor !== '');

      let visiveis = 0;
      cards.forEach((card) => {
        const ok = ativos.every((f) => card.dataset[f.campo] === f.valor);
        card.classList.toggle('hidden', !ok);
        if (ok) visiveis++;
      });
      if (contagem) contagem.textContent = String(visiveis);
    }

    selects.forEach((s) => s.addEventListener('change', filtrar));
  </script>
</Layout>
